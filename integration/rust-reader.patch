From 584f8fa2391123245b6fd05be44d8619d780efd8 Mon Sep 17 00:00:00 2001
From: Vic Herrera <126992509+vhhr7@users.noreply.github.com>
Date: Mon, 19 Oct 2026 19:42:41 -0500
Subject: [PATCH 2/4] AAF import: resolve each source once, offer composition
 choice, start folder picker

- file_source returns early for a known source, so each WAV is probed and
  each relink is reported once however many edits use it. The per-slot
  PhysicalTrackNumber check still runs first.
- When an AAF holds several compositions, the Session Data window lists them
  and passes the chosen MobID to file.preview_aaf.
- "Choose media folder..." opens at the current media folder instead of
  receiving a label as its start path.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/engine/tests/aaf_import.rs | 27 ++++++++++++++++
 crates/interchange/src/aaf.rs     | 32 ++++++++++---------
 crates/ui-egui/src/aaf_import.rs  | 53 +++++++++++++++++++++++++++++--
 3 files changed, 95 insertions(+), 17 deletions(-)

diff --git a/crates/engine/tests/aaf_import.rs b/crates/engine/tests/aaf_import.rs
index c6fc34e..a5cee65 100644
--- a/crates/engine/tests/aaf_import.rs
+++ b/crates/engine/tests/aaf_import.rs
@@ -197,3 +197,30 @@ fn rust_reader_requires_every_locator_in_the_chosen_media_folder() {
     std::fs::write(f.dir.join("Diálogo á #1.wav"), b"RIFF\0\0\0\0WAVEnot audio").unwrap();
     assert!(f.preview().is_err());
 }
+
+#[test]
+fn relinked_sources_are_reported_once_however_many_edits_use_them() {
+    let f = AafFolder::new();
+    let moved = f.dir.join("moved media");
+    std::fs::create_dir(&moved).unwrap();
+    for name in ["Diálogo á #1.wav", "Ambiente estéreo.wav"] {
+        std::fs::rename(f.dir.join(name), moved.join(name)).unwrap();
+    }
+    let aaf = f.dir.join("Montaje sintético.aaf");
+    let preview = Engine::default().execute("file.preview_aaf", &json!({"path": aaf, "media_dir": moved})).unwrap();
+    let relinks = preview["plan"]["warnings"].as_array().unwrap().iter().filter(|w| w.as_str().unwrap().starts_with("Relinked ")).count();
+    // Three edits, two source files: the dialogue source is used twice.
