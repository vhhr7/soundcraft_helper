From 05c07ff16de1b7b7cc17ed5e29ad927e29a543c8 Mon Sep 17 00:00:00 2001
From: Vic Herrera <126992509+vhhr7@users.noreply.github.com>
Date: Mon, 19 Oct 2026 19:56:12 -0500
Subject: [PATCH 3/4] AAF import: lock the composition selector while analysis
 runs

A selection change during analysis could leave a plan for the previous
composition in the window and enable Import with it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ui-egui/src/aaf_import.rs | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/crates/ui-egui/src/aaf_import.rs b/crates/ui-egui/src/aaf_import.rs
index d615b02..b2d3edc 100644
--- a/crates/ui-egui/src/aaf_import.rs
+++ b/crates/ui-egui/src/aaf_import.rs
@@ -153,10 +153,13 @@ pub fn show(app: &mut SoundApp, ctx: &egui::Context) {
                 ui.horizontal(|ui| {
                     ui.label("Composition");
                     let current=state.compositions.iter().find(|(_,id)|*id==state.composition).map_or("Choose one…".to_string(),|(n,_)|n.clone());
-                    egui::ComboBox::from_id_salt("aaf_composition").selected_text(current).show_ui(ui,|ui|{
-                        for (name,id) in &state.compositions {
-                            if ui.selectable_label(state.composition==*id,format!("{name}  ({id})")).clicked() { state.composition=id.clone(); state.preview=None; }
-                        }
+                    // Locked while analyzing, so a finished analysis always matches the selection.
+                    ui.add_enabled_ui(state.busy.is_none(),|ui|{
+                        egui::ComboBox::from_id_salt("aaf_composition").selected_text(current).show_ui(ui,|ui|{
+                            for (name,id) in &state.compositions {
+                                if ui.selectable_label(state.composition==*id,format!("{name}  ({id})")).clicked() { state.composition=id.clone(); state.preview=None; }
+                            }
+                        });
                     });
                 });
             }
