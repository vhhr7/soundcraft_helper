+        v.extend((48000 * u32::from(channels) * u32::from(bits / 8)).to_le_bytes());
+        v.extend((channels * bits / 8).to_le_bytes());
+        v.extend(bits.to_le_bytes());
+        v.extend(b"data");
+        v.extend(data.to_le_bytes());
