+
+/// Bounded, root-checked media read for interchange imports.
+pub(crate) fn read_interchange_file(path: &Path, limit: u64) -> Result<Vec<u8>> {
+    use std::io::Read;
+    crate::file_access::check_read(path).map_err(EngineError::Io)?;
+    let meta = std::fs::metadata(path).map_err(|e| EngineError::Io(e.to_string()))?;
+    if !meta.is_file() || meta.len() > limit {
+        return Err(EngineError::Io(format!("{}: not a regular file or exceeds import byte limit", path.display())));
+    }
+    let mut bytes = Vec::new();
+    std::fs::File::open(path).and_then(|f| f.take(limit.saturating_add(1)).read_to_end(&mut bytes)).map_err(|e| EngineError::Io(e.to_string()))?;
+    if bytes.len() as u64 > limit {
+        return Err(EngineError::Io("media exceeds import byte limit".into()));
+    }
+    Ok(bytes)
+}
+
+/// The optional AAF reader is isolated from construction of the session. It receives only a
+/// user-chosen local file and relink folder; Python enforces that every referenced WAV is in it.
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn read_aaf_plan(path: &str, media_dir: &str, composition: Option<&str>) -> Result<Value> {
+    use std::{
+        io::Read,
+        process::{Command, Stdio},
+        time::{Duration, Instant},
+    };
+    crate::file_access::check_read(path).map_err(EngineError::Io)?;
+    crate::file_access::check_read(media_dir).map_err(EngineError::Io)?;
+    let meta = std::fs::metadata(path).map_err(|e| EngineError::Io(e.to_string()))?;
+    if !meta.is_file() || meta.len() > 512 * 1024 * 1024 || !Path::new(media_dir).is_dir() {
+        return Err(EngineError::Io("choose an AAF file (at most 512 MiB) and its media folder".into()));
+    }
+    let python = std::env::var_os("SOUNDCRAFT_AAF_PYTHON")
+        .ok_or_else(|| EngineError::Io("AAF reader is not configured. Launch the SoundCraft AAF development build.".into()))?;
+    let script = std::env::var_os("SOUNDCRAFT_AAF_READER").ok_or_else(|| EngineError::Io("AAF reader script is not configured".into()))?;
+    let mut command = Command::new(python);
+    command
+        .arg("-I")
+        .arg("-B")
+        .arg(script)
+        .arg(path)
+        .arg("--media-dir")
+        .arg(media_dir)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    if let Some(id) = composition {
+        command.arg("--composition").arg(id);
+    }
+    let mut child = command.spawn().map_err(|e| EngineError::Io(format!("cannot start AAF reader: {e}")))?;
+    let stdout = child.stdout.take().ok_or_else(|| EngineError::Io("reader stdout unavailable".into()))?;
+    let stderr = child.stderr.take().ok_or_else(|| EngineError::Io("reader stderr unavailable".into()))?;
+    let out = std::thread::spawn(move || {
+        let mut b = Vec::new();
+        stdout.take(32 * 1024 * 1024 + 1).read_to_end(&mut b).map(|_| b)
+    });
+    let err = std::thread::spawn(move || {
+        let mut b = Vec::new();
+        stderr.take(64 * 1024 + 1).read_to_end(&mut b).map(|_| b)
+    });
+    let start = Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Some(status),
+            Ok(None) if start.elapsed() < Duration::from_secs(45) => std::thread::sleep(Duration::from_millis(20)),
+            _ => {
+                let _ = child.kill();
+                let _ = child.wait();
+                break None;
+            }
+        }
+    };
+    let bytes = out.join().map_err(|_| EngineError::Io("reader output failed".into()))?.map_err(|e| EngineError::Io(e.to_string()))?;
+    let errors = err.join().map_err(|_| EngineError::Io("reader diagnostics failed".into()))?.map_err(|e| EngineError::Io(e.to_string()))?;
+    if status.is_none() {
+        return Err(EngineError::Io("AAF reader timed out or could not be monitored (45 s limit)".into()));
+    }
+    if !status.is_some_and(|s| s.success()) {
+        return Err(EngineError::Io(String::from_utf8_lossy(&errors).trim().to_string()));
+    }
+    if bytes.len() > 32 * 1024 * 1024 {
+        return Err(EngineError::Io("AAF plan exceeds 32 MiB".into()));
+    }
+    serde_json::from_slice(&bytes).map_err(|e| EngineError::Io(format!("invalid AAF plan: {e}")))
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn read_aaf_plan(_: &str, _: &str, _: Option<&str>) -> Result<Value> {
+    Err(EngineError::Io("AAF reader is available only in the desktop development build".into()))
+}
